{
    "name": "smart-dato/correos-sdk",
    "description": "Correos SOAP pre-registration and tracking SDK for Laravel",
    "keywords": [
        "SmartDato",
        "laravel",
        "correos-sdk"
    ],
    "homepage": "https://bitbucket.org/smartdato/correos-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "SmartDato",
            "email": "info@smart-dato.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "ext-soap": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0",
        "pestphp/pest-plugin-arch": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "SmartDato\\CorreosSdk\\": "src/",
            "SmartDato\\CorreosSdk\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartDato\\CorreosSdk\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-correos-sdk --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmartDato\\CorreosSdk\\CorreosSdkServiceProvider"
            ],
            "aliases": {
                "CorreosSdk": "SmartDato\\CorreosSdk\\Facades\\CorreosSdk"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
